{
  "realm": "dev",
  "enabled": true,
  "displayName": "client-login-policy dev",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      {
        "name": "staff",
        "description": "Dev role, for policies that key on a realm role."
      }
    ],
    "client": {
      "restricted-app": [
        {
          "name": "access",
          "description": "Dev role, for checking that the audience filter also removes client roles."
        }
      ]
    }
  },
  "groups": [
    {
      "name": "board",
      "path": "/board"
    },
    {
      "name": "members",
      "path": "/members"
    }
  ],
  "clients": [
    {
      "clientId": "demo-app",
      "name": "Demo App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "https://oidcdebugger.com/debug",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "*"
      ],
      "protocolMappers": [
        {
          "name": "restricted-app audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "restricted-app",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client login policy audience filter",
          "protocol": "openid-connect",
          "protocolMapper": "client-login-policy-audience-filter",
          "config": {}
        }
      ]
    },
    {
      "clientId": "restricted-app",
      "name": "Restricted App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": true,
      "redirectUris": [
        "http://localhost:8080/*",
        "https://oidcdebugger.com/debug",
        "https://oauth.pstmn.io/v1/callback"
      ],
      "webOrigins": [
        "*"
      ]
    },
    {
      "clientId": "backend",
      "name": "Backend",
      "enabled": true,
      "publicClient": false,
      "secret": "password",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "restricted-app audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "restricted-app",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "client login policy audience filter",
          "protocol": "openid-connect",
          "protocolMapper": "client-login-policy-audience-filter",
          "config": {}
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.org",
      "firstName": "Alice",
      "lastName": "Allowed",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-dev",
        "staff"
      ],
      "groups": [
        "/board"
      ],
      "clientRoles": {
        "restricted-app": [
          "access"
        ]
      }
    },
    {
      "username": "bob",
      "email": "bob@example.org",
      "firstName": "Bob",
      "lastName": "Blocked",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-dev"
      ],
      "groups": [
        "/members"
      ],
      "clientRoles": {
        "restricted-app": [
          "access"
        ]
      }
    },
    {
      "username": "service-account-backend",
      "enabled": true,
      "serviceAccountClientId": "backend",
      "realmRoles": [
        "default-roles-dev"
      ],
      "clientRoles": {
        "restricted-app": [
          "access"
        ]
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser with login policy",
      "description": "browser flow with the client login policy as a final required step",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "flowAlias": "browser with login policy authenticate",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        },
        {
          "authenticator": "client-login-policy",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false,
          "authenticatorConfig": "dev policy"
        }
      ]
    },
    {
      "alias": "browser with login policy authenticate",
      "description": "the stock browser alternatives, wrapped so a required step can follow them",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser with login policy forms",
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser with login policy forms",
      "description": "username, password and conditional OTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "flowAlias": "browser with login policy 2fa",
          "requirement": "CONDITIONAL",
          "priority": 20,
          "autheticatorFlow": true,
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser with login policy 2fa",
      "description": "OTP when the user has one configured",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "requirement": "REQUIRED",
          "priority": 10,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "autheticatorFlow": false,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "browserFlow": "browser with login policy",
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "authenticatorConfig": [
    {
      "alias": "dev policy",
      "config": {
        "policy": "{\n  \"version\": 1,\n  \"default\": [\n    {\n      \"deny\": {\n        \"attribute\": \"guest\",\n        \"value\": \"TRUE\"\n      }\n    }\n  ],\n  \"clients\": {\n    \"restricted-app\": [\n      {\n        \"allow\": {\n          \"realmRole\": \"staff\"\n        }\n      },\n      {\n        \"allow\": {\n          \"group\": \"/board\"\n        }\n      }\n    ]\n  }\n}"
      }
    }
  ]
}
