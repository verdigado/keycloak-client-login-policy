{
  "realm": "dev",
  "enabled": true,
  "displayName": "client-login-policy dev",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "staff", "description": "Dev role, for policies that key on a realm role." }
    ]
  },
  "groups": [
    { "name": "board", "path": "/board" },
    { "name": "members", "path": "/members" }
  ],
  "clients": [
    {
      "clientId": "demo-app",
      "name": "Demo App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "https://oauth.pstmn.io/v1/callback"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "restricted-app",
      "name": "Restricted App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:8080/*", "https://oauth.pstmn.io/v1/callback"],
      "webOrigins": ["*"]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.org",
      "firstName": "Alice",
      "lastName": "Allowed",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["staff"],
      "groups": ["/board"]
    },
    {
      "username": "bob",
      "email": "bob@example.org",
      "firstName": "Bob",
      "lastName": "Blocked",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "groups": ["/members"]
    }
  ]
}
